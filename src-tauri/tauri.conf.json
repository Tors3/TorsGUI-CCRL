{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TorsGUI",
  "version": "0.6.7",
  "identifier": "io.github.tors3.torsgui",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui"
    }
  },
  "app": {
    "windows": [
      {
        "title": "TorsGUI",
        "width": 1600,
        "height": 960,
        "minWidth": 960,
        "minHeight": 600,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/torsgui-runner",
      "binaries/torsgui-demo-engine"
    ],
    "category": "Utility",
    "shortDescription": "Tournament manager for CCRL testers",
    "longDescription": "TorsGUI orchestrates fastchess for CCRL rating-list testers: NUMA-aware gauntlets that survive the GUI, CCRL exports and forum posts.",
    "license": "GPL-3.0-or-later",
    "publisher": "TorsGUI contributors",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "resources/engines/": "engines/",
      "resources/books/": "books/"
    }
  }
}
